    "# Cell 5: Automatically detect only the ECG plotting region\n",
    "\n",
    "def detect_red_grid_mask(image_rgb: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Detect the red/pink ECG grid using HSV and LAB color spaces.\"\"\"\n",
    "    try:\n",
    "        if image_rgb is None or image_rgb.ndim != 3:\n",
    "            raise ValueError(\"Input must be a valid RGB image.\")\n",
    "\n",
    "        hsv = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2HSV)\n",
    "        lab = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2LAB)\n",
    "        h, s, v = cv2.split(hsv)\n",
    "        l_channel, a_channel, b_channel = cv2.split(lab)\n",
    "\n",
    "        # ECG grid is usually low-to-moderate saturation red/pink.\n",
    "        hsv_red_low = ((h <= 15) | (h >= 165)) & (s >= 10) & (v >= 80)\n",
    "        lab_red = a_channel >= max(132, int(np.percentile(a_channel, 70)))\n",
    "\n",
    "        # Keep faint red pixels but reject dark black text/waveform.\n",
    "        red_mask = (hsv_red_low | lab_red) & (l_channel >= 120)\n",
    "        red_mask = red_mask.astype(np.uint8) * 255\n",
    "\n",
    "        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 3))\n",
    "        return cv2.morphologyEx(red_mask, cv2.MORPH_OPEN, kernel, iterations=1)\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to detect red ECG grid mask.\") from error\n",
    "\n",
    "\n",
    "def find_dense_projection_bounds(mask: np.ndarray, axis: int, min_fraction: float, smooth_sigma: float) -> tuple[int, int]:\n",
    "    \"\"\"Find plotting bounds from dense grid-line projections.\"\"\"\n",
    "    try:\n",
    "        if mask is None or mask.ndim != 2:\n",
    "            raise ValueError(\"Mask must be a 2D array.\")\n",
    "\n",
    "        projection = np.sum(mask > 0, axis=axis).astype(float)\n",
    "        projection = gaussian_filter1d(projection, sigma=smooth_sigma)\n",
    "\n",
    "        opposite_size = mask.shape[axis]\n",
    "        absolute_threshold = min_fraction * opposite_size\n",
    "\n",
    "        nonzero_projection = projection[projection > 0]\n",
    "        if len(nonzero_projection) == 0:\n",
    "            raise RuntimeError(\"Projection is empty.\")\n",
    "\n",
    "        adaptive_threshold = max(absolute_threshold, np.percentile(nonzero_projection, 25))\n",
    "        dense = projection > adaptive_threshold\n",
    "        indices = np.where(dense)[0]\n",
    "\n",
    "        if len(indices) == 0:\n",
    "            raise RuntimeError(\"No dense grid region found from projection.\")\n",
    "\n",
    "        return int(indices.min()), int(indices.max())\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to find dense projection bounds.\") from error\n",
    "\n",
    "\n",
    "def refine_bounds_with_grid_edges(red_grid_mask: np.ndarray) -> tuple[int, int, int, int]:\n",
    "    \"\"\"Refine ECG plotting-region bounds using red grid edge pixels and projections.\"\"\"\n",
    "    try:\n",
    "        image_h, image_w = red_grid_mask.shape\n",
    "\n",
    "        # Connect tiny grid dots/segments into continuous grid structure.\n",
    "        h_kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (max(15, image_w // 80), 1))\n",
    "        v_kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (1, max(15, image_h // 80)))\n",
    "\n",
    "        horizontal_grid = cv2.morphologyEx(red_grid_mask, cv2.MORPH_CLOSE, h_kernel, iterations=1)\n",
    "        vertical_grid = cv2.morphologyEx(red_grid_mask, cv2.MORPH_CLOSE, v_kernel, iterations=1)\n",
    "        connected_grid = cv2.bitwise_or(horizontal_grid, vertical_grid)\n",
    "\n",
    "        x_min, x_max = find_dense_projection_bounds(connected_grid, 0, 0.10, max(2, image_w // 400))\n",
    "        y_min, y_max = find_dense_projection_bounds(connected_grid, 1, 0.10, max(2, image_h // 400))\n",
    "\n",
    "        # Use actual red pixels inside projection bounds to tighten the rectangle.\n",
    "        roi = red_grid_mask[y_min:y_max + 1, x_min:x_max + 1]\n",
    "        ys, xs = np.where(roi > 0)\n",
    "\n",
    "        if len(xs) > 0 and len(ys) > 0:\n",
    "            x_min += int(np.percentile(xs, 0.5))\n",
    "            x_max = x_min + int(np.percentile(xs, 99.5)) - int(np.percentile(xs, 0.5))\n",
    "            y_min += int(np.percentile(ys, 0.5))\n",
    "            y_max = y_min + int(np.percentile(ys, 99.5)) - int(np.percentile(ys, 0.5))\n",
    "\n",
    "        # Small padding keeps the outer plotting border and waveform tips.\n",
    "        pad_x, pad_y = max(4, int(0.006 * (x_max - x_min + 1))), max(4, int(0.008 * (y_max - y_min + 1)))\n",
    "\n",
    "        x_min, y_min = max(0, x_min - pad_x), max(0, y_min - pad_y)\n",
    "        x_max, y_max = min(image_w - 1, x_max + pad_x), min(image_h - 1, y_max + pad_y)\n",
    "\n",
    "        width, height = x_max - x_min + 1, y_max - y_min + 1\n",
    "\n",
    "        if width < 0.35 * image_w or height < 0.20 * image_h:\n",
    "            raise RuntimeError(\"Detected ECG grid region is unexpectedly small.\")\n",
    "\n",
    "        return int(x_min), int(y_min), int(width), int(height)\n",
    "    except Exception as error:\n",
