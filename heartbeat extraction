    "# Cell 7\n",
    "\n",
    "def get_original_row_image(row_data, plot_image):\n",
    "    y_start, y_end = int(row_data[\"y_start\"]), int(row_data[\"y_end\"])\n",
    "    if plot_image is not None and 0 <= y_start < y_end <= plot_image.shape[0]:\n",
    "        return plot_image[y_start:y_end].copy()\n",
    "    return row_data[\"image\"].copy()\n",
    "\n",
    "def find_true_runs(binary_array):\n",
    "    padded = np.pad(np.asarray(binary_array, dtype=np.int8), (1, 1), mode=\"constant\")\n",
    "    changes = np.diff(padded)\n",
    "    starts = np.where(changes == 1)[0]\n",
    "    ends = np.where(changes == -1)[0]\n",
    "    return [(int(s), int(e)) for s, e in zip(starts, ends)]\n",
    "\n",
    "def detect_dark_waveform_ink(row_rgb):\n",
    "    \"\"\"Detect ink and apply morphological cleanup to kill grid noise.\"\"\"\n",
    "    gray = cv2.cvtColor(row_rgb, cv2.COLOR_RGB2GRAY)\n",
    "    darkest = float(np.percentile(gray, 1.0))\n",
    "    ink_thresh = int(np.clip(darkest + 75, 95, 135))\n",
    "    mask = (gray <= ink_thresh).astype(np.uint8)\n",
    "    \n",
    "    # NEW: Clean up isolated noise pixels that cause the 'barcode' effect\n",
    "    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (2, 2))\n",
    "    mask_cleaned = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n",
    "    \n",
    "    return gray, mask_cleaned\n",
    "def detect_calibration_pulse_end(dark_ink_mask):\n",
    "    height, width = dark_ink_mask.shape\n",
    "    cols = dark_ink_mask[:, :min(width, int(width * 0.15))].sum(axis=0)\n",
    "    tall_cols = cols >= max(12, int(height * 0.22))\n",
    "    \n",
    "    cal_end = 0\n",
    "    for s, e in find_true_runs(tall_cols):\n",
    "        if s <= min(40, int(width * 0.05)):\n",
    "            cal_end = max(cal_end, e)\n",
    "    return int(min(cal_end + 3, int(width * 0.10))) if cal_end > 0 else 0\n",
    "\n",
    "def detect_vertical_separator_columns(dark_ink_mask, cal_end):\n",
    "    height, width = dark_ink_mask.shape\n",
    "    cols = dark_ink_mask.sum(axis=0)\n",
    "    tall_cols = cols >= max(20, int(height * 0.55))\n",
    "    \n",
    "    blocked = np.zeros(width, dtype=bool)\n",
    "    blocked[:cal_end] = True\n",
    "    for s, e in find_true_runs(tall_cols):\n",
    "        blocked[max(0, s - 22):min(width, e + 22)] = True # Aggressive text block\n",
    "    return blocked\n",
    "\n",
    "def build_trace_segments(blocked_columns, min_width=25):\n",
    "    segments = [(s, e) for s, e in find_true_runs(~blocked_columns) if (e - s) >= min_width]\n",
    "    if not segments: raise RuntimeError(\"No usable segments.\")\n",
    "    return segments\n",
    "\n",
    "def estimate_segment_baseline(dark_ink_mask, start_x, end_x):\n",
    "    height = dark_ink_mask.shape[0]\n",
    "    smoothed = gaussian_filter1d(dark_ink_mask[:, start_x:end_x].sum(axis=1).astype(float), 2.0)\n",
    "    lo, hi = max(0, int(height * 0.2)), min(height, int(height * 0.85))\n",
    "    return lo + int(np.argmax(smoothed[lo:hi]))\n",
    "def trace_segment_cluster_tracking(dark_ink_mask, start_x, end_x, baseline_y):\n",
    "    \"\"\"Tracks the continuous ECG line, ignoring stray grid/noise pixels.\"\"\"\n",
    "    segment_width = end_x - start_x\n",
    "    traced_y = np.full(segment_width, np.nan)\n",
    "    support = np.zeros(segment_width, dtype=bool)\n",
    "\n",
    "    current_y = baseline_y\n",
    "\n",
    "    for col_index in range(segment_width):\n",
    "        ink_pixels = np.where(dark_ink_mask[:, start_x + col_index])[0]\n",
    "\n",
    "        if len(ink_pixels) > 0:\n",
    "            # Group pixels into contiguous clusters\n",
    "            breaks = np.where(np.diff(ink_pixels) != 1)[0] + 1\n",
    "            clusters = np.split(ink_pixels, breaks)\n",
    "\n",
    "            # Find the cluster whose edge or center is closest to our current trace\n",
    "            best_cluster = min(\n",
    "                clusters, \n",
    "                key=lambda c: min(abs(c[0] - current_y), abs(c[-1] - current_y))\n",
    "            )\n",
    "\n",
    "            top_y = best_cluster[0]\n",
    "            bottom_y = best_cluster[-1]\n",
    "            thickness = bottom_y - top_y\n",
    "\n",
    "            # If it's a flat line, take the center. If it's a spike, snap to the extreme.\n",
    "            if thickness <= 12:\n",
    "                new_y = (top_y + bottom_y) / 2.0\n",
    "            else:\n",
    "                if abs(top_y - baseline_y) > abs(bottom_y - baseline_y):\n",
    "                    new_y = top_y  # Sharp R-wave (upward)\n",
    "                else:\n",
    "                    new_y = bottom_y # Sharp S-wave (downward)\n",
    "\n",
    "            traced_y[col_index] = new_y\n",
    "            current_y = new_y\n",
    "            support[col_index] = True\n",
    "\n",
    "    return traced_y, support\n",
    "def interpolate_trace_inside_segments(traced_y, support, segments):\n",
    "    interp_y = traced_y.copy()\n",
    "    \n",
    "    # 1. Interpolate small gaps strictly INSIDE each valid segment\n",
    "    for s, e in segments:\n",
    "        seg_y, seg_sup = traced_y[s:e], support[s:e]\n",
    "        if seg_sup.sum() >= 2:\n",
    "            x = np.arange(seg_y.size)\n",
    "            interp_y[s:e] = np.interp(x, x[seg_sup], seg_y[seg_sup])\n",
    "            \n",
    "    # 2. FIX: Handle the empty edges and the gaps between leads\n",
    "    # Instead of connecting different leads with slanted lines, \n",
    "    # we force all dead zones (separators, edges) to the natural baseline.\n",
    "    valid = np.isfinite(interp_y)\n",
    "    if valid.any():\n",
    "        baseline_val = np.nanmedian(interp_y)\n",
    "        invalid = ~valid\n",
    "        interp_y[invalid] = baseline_val # Snaps all gaps perfectly to baseline\n",
    "        \n",
    "    return interp_y\n",
    "\n",
    "def normalize_traced_ecg_signal(trace_y):\n",
    "    base = float(np.median(trace_y))\n",
    "    lo, hi = np.percentile(trace_y, [2, 98])\n",
    "    scale = max((hi - lo) / 2.0, 1.0)\n",
    "    return (-(trace_y - base) / scale).astype(np.float32)\n",
    "\n",
    "def extract_sharp_ecg_row_signal(row_rgb):\n",
    "    gray, mask = detect_dark_waveform_ink(row_rgb)\n",
    "    cal_end = detect_calibration_pulse_end(mask)\n",
    "    blocked = detect_vertical_separator_columns(mask, cal_end)\n",
    "    segments = build_trace_segments(blocked)\n",
    "    \n",
    "    height, width = mask.shape\n",
    "    traced_y = np.full(width, np.nan)\n",
    "    support = np.zeros(width, dtype=bool)\n",
    "    \n",
    "    for s, e in segments:\n",
    "        base_y = estimate_segment_baseline(mask, s, e)\n",
    "        seg_y, seg_sup = trace_segment_cluster_tracking(mask, s, e, base_y)\n",
    "        traced_y[s:e], support[s:e] = seg_y, seg_sup\n",
    "        \n",
    "    interp_y = interpolate_trace_inside_segments(traced_y, support, segments)\n",
    "    \n",
    "    # Apply light smoothing to remove 1-pixel jaggedness from the trace\n",
    "    interp_y = gaussian_filter1d(interp_y, sigma=0.8) \n",
    "    \n",
    "    return {\n",
    "        \"row_rgb\": row_rgb, \"dark_ink_mask\": mask, \"calibration_end\": cal_end,\n",
    "        \"trace_segments\": segments, \"traced_y\": traced_y, \"signal\": normalize_traced_ecg_signal(interp_y)\n",
    "    }\n",
    "def display_sharp_signal_extraction(results):\n",
    "    for res in results:\n",
    "        rgb, h, w = res[\"row_rgb\"], res[\"row_rgb\"].shape[0], res[\"row_rgb\"].shape[1]\n",
    "        cal = res[\"calibration_end\"]\n",
    "\n",
    "        plt.figure(figsize=(18, 2.5))\n",
    "        plt.imshow(rgb)\n",
    "        plt.title(f\"Row {res['row_index']}: Original ECG\")\n",
    "        plt.axis(\"off\"); plt.show()\n",
    "\n",
    "        plt.figure(figsize=(18, 2.5))\n",
    "        plt.imshow(rgb)\n",
    "        for s, e in res[\"trace_segments\"]:\n",
    "            plt.plot(np.arange(s, e), res[\"traced_y\"][s:e], color=\"red\", lw=1.2)\n",
    "        if cal > 0: plt.axvspan(0, cal, color=\"gold\", alpha=0.2)\n",
    "        plt.xlim(0, w-1); plt.ylim(h-1, 0); plt.axis(\"off\")\n",
    "        plt.title(f\"Row {res['row_index']}: Cluster-Tracked Centerline\"); plt.show()\n",
    "\n",
    "        plt.figure(figsize=(18, 3.5))\n",
    "        plt.plot(res[\"signal\"], color=\"black\", lw=1.0)\n",
    "        if cal > 0: plt.axvspan(0, cal, color=\"orange\", alpha=0.2)\n",
    "        plt.title(f\"Row {res['row_index']}: Normalized Signal\")\n",
    "        plt.xlim(0, w-1); plt.show()\n",
    "        print(\"-\" * 100)\n",
    "\n",
    "# --- EXECUTION ---\n",
    "original_img = globals().get(\"ecg_plot_rgb\", None)\n",
    "ecg_rows = globals().get(\"ecg_rows\", [])\n",
    "results = []\n",
    "\n",
    "for row in ecg_rows:\n",
    "    rgb = get_original_row_image(row, original_img)\n",
    "    ext = extract_sharp_ecg_row_signal(rgb)\n",
    "    ext[\"row_index\"] = int(row[\"row_index\"])\n",
    "    results.append(ext)\n",
    "\n",
    "if results:\n",
    "    display_sharp_signal_extraction(results)\n",
    "    \n",
    "    from pathlib import Path\n",
    "    INTERMEDIATE_DIR = Path(\"intermediate_results\")\n",
    "    INTERMEDIATE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    for res in results:\n",
    "        np.save(INTERMEDIATE_DIR / f\"cell_08_row_{res['row_index']}_signal.npy\", res[\"signal\"])\n",
    "        cv2.imwrite(str(INTERMEDIATE_DIR / f\"cell_08_row_{res['row_index']}_mask.png\"), res[\"dark_ink_mask\"] * 255)"
