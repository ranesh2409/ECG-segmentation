    "# Cell 7: Automatically detect ECG rows using horizontal projection\n",
    "\n",
    "def create_row_detection_mask(grid_removed_rgb: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Create a clean binary mask for ECG row detection from the grid-removed image.\"\"\"\n",
    "    try:\n",
    "        if grid_removed_rgb is None or grid_removed_rgb.ndim != 3:\n",
    "            raise ValueError(\"Input must be a valid RGB image.\")\n",
    "\n",
    "        gray = cv2.cvtColor(grid_removed_rgb, cv2.COLOR_RGB2GRAY)\n",
    "\n",
    "        # Use only very dark pixels so faint residual grid does not dominate row detection\n",
    "        dark_threshold = min(115, int(np.percentile(gray, 18)))\n",
    "        dark_mask = (gray <= dark_threshold).astype(np.uint8) * 255\n",
    "\n",
    "        # Remove long vertical separator lines and calibration strokes\n",
    "        image_h, _ = dark_mask.shape\n",
    "        vertical_kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (1, max(20, image_h // 6)))\n",
    "        long_vertical_lines = cv2.morphologyEx(dark_mask, cv2.MORPH_OPEN, vertical_kernel, iterations=1)\n",
    "\n",
    "        cleaned_mask = cv2.bitwise_and(dark_mask, cv2.bitwise_not(long_vertical_lines))\n",
    "\n",
    "        # Light cleaning to keep waveform strokes but remove isolated print/noise pixels\n",
    "        small_kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (2, 2))\n",
    "        return cv2.morphologyEx(cleaned_mask, cv2.MORPH_OPEN, small_kernel, iterations=1)\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to create row-detection mask.\") from error\n",
    "\n",
    "\n",
    "def detect_row_centers_from_projection(row_mask: np.ndarray, expected_rows: int = 4) -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n",
    "    \"\"\"Detect ECG row centers from a smoothed horizontal projection.\"\"\"\n",
    "    try:\n",
    "        if row_mask is None or row_mask.ndim != 2:\n",
    "            raise ValueError(\"Row mask must be a 2D binary image.\")\n",
    "\n",
    "        image_h, _ = row_mask.shape\n",
    "        raw_projection = np.sum(row_mask > 0, axis=1).astype(float)\n",
    "\n",
    "        # Smooth at row-band scale so each ECG row becomes one broad peak\n",
    "        smooth_sigma = max(8, image_h // 70)\n",
    "        smoothed_projection = gaussian_filter1d(raw_projection, sigma=smooth_sigma)\n",
    "\n",
    "        min_distance = max(30, image_h // 6)\n",
    "        prominence = max(0.08 * np.max(smoothed_projection), np.std(smoothed_projection))\n",
    "\n",
    "        peaks, _ = find_peaks(smoothed_projection, distance=min_distance, prominence=prominence)\n",
    "\n",
    "        # Fallback with relaxed constraints if not enough rows are found\n",
    "        if len(peaks) < expected_rows:\n",
    "            peaks, _ = find_peaks(\n",
    "                smoothed_projection,\n",
    "                distance=max(20, image_h // 8),\n",
    "                prominence=max(0.03 * np.max(smoothed_projection), 1.0)\n",
    "            )\n",
    "\n",
    "        if len(peaks) < expected_rows:\n",
    "            raise RuntimeError(f\"Detected only {len(peaks)} row centers, expected {expected_rows}.\")\n",
    "\n",
    "        # Select the strongest peaks corresponding to expected_rows\n",
    "        strongest_peak_indices = np.argsort(smoothed_projection[peaks])[-expected_rows:]\n",
    "        row_centers = np.sort(peaks[strongest_peak_indices]).astype(int)\n",
    "\n",
    "        return raw_projection, smoothed_projection, row_centers\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to detect ECG row centers.\") from error\n",
    "\n",
    "\n",
    "def estimate_row_boundaries(row_mask: np.ndarray, row_centers: np.ndarray) -> list[tuple[int, int]]:\n",
    "    \"\"\"Estimate tight ECG row boundaries around detected row centers.\"\"\"\n",
    "    try:\n",
    "        image_h, image_w = row_mask.shape\n",
    "        row_centers = np.sort(np.asarray(row_centers).astype(int))\n",
    "\n",
    "        projection = gaussian_filter1d(np.sum(row_mask > 0, axis=1).astype(float), sigma=max(3, image_h // 160))\n",
    "        nonzero_projection = projection[projection > 0]\n",
    "        activity_threshold = max(0.015 * image_w, np.percentile(nonzero_projection, 20) if len(nonzero_projection) > 0 else 1)\n",
    "\n",
    "        boundaries = []\n",
    "        for idx, center in enumerate(row_centers):\n",
    "            upper_limit = 0 if idx == 0 else int((row_centers[idx - 1] + center) / 2)\n",
    "            lower_limit = image_h - 1 if idx == len(row_centers) - 1 else int((center + row_centers[idx + 1]) / 2)\n",
    "\n",
    "            y_start, y_end = int(center), int(center)\n",
    "            \n",
    "            while y_start > upper_limit and projection[y_start] > activity_threshold:\n",
    "                y_start -= 1\n",
    "            while y_end < lower_limit and projection[y_end] > activity_threshold:\n",
    "                y_end += 1\n",
    "\n",
    "            # Add physiologic plotting margin\n",
    "            margin = max(18, int(1.20 * max(1, y_end - y_start + 1)))\n",
    "            y_start, y_end = max(upper_limit, y_start - margin), min(lower_limit, y_end + margin)\n",
    "\n",
    "            # Prevent overlap\n",
    "            if idx > 0:\n",
    "                previous_start, previous_end = boundaries[-1]\n",
    "                if y_start <= previous_end:\n",
    "                    midpoint = int((previous_end + y_start) / 2)\n",
    "                    boundaries[-1] = (previous_start, midpoint)\n",
    "                    y_start = midpoint + 1\n",
    "\n",
    "            if y_end <= y_start:\n",
    "                raise RuntimeError(f\"Invalid boundary for row center {center}.\")\n",
    "\n",
    "            boundaries.append((int(y_start), int(y_end)))\n",
    "\n",
    "        return boundaries\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to estimate ECG row boundaries.\") from error\n",
    "\n",
    "\n",
    "def extract_rows_from_boundaries(image_rgb: np.ndarray, row_centers: np.ndarray, row_boundaries: list[tuple[int, int]]) -> list[dict[str, Any]]:\n",
    "    \"\"\"Extract ECG row images using tight projection-based row boundaries.\"\"\"\n",
    "    try:\n",
    "        if len(row_centers) != len(row_boundaries):\n",
    "            raise ValueError(\"Number of row centers and boundaries must match.\")\n",
    "\n",
    "        extracted_rows = []\n",
    "        for row_index, (center, (y_start, y_end)) in enumerate(zip(row_centers, row_boundaries), start=1):\n",
    "            row_image = image_rgb[y_start:y_end + 1, :].copy()\n",
    "\n",
    "            if row_image.size == 0:\n",
    "                raise RuntimeError(f\"Extracted row {row_index} is empty.\")\n",
    "\n",
    "            extracted_rows.append({\n",
    "                \"row_index\": row_index,\n",
    "                \"center_y\": int(center),\n",
    "                \"y_start\": int(y_start),\n",
    "                \"y_end\": int(y_end),\n",
    "                \"image\": row_image\n",
    "            })\n",
    "\n",
    "        return extracted_rows\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to extract ECG rows.\") from error\n",
