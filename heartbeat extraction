    "# ============================================================\n",
    "# Cell 8 : Precision Trimmed ECG Peak Detection (Cleaned Signal)\n",
    "# ============================================================\n",
    "\n",
    "import numpy as np\n",
    "import scipy.signal as signal\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "def detect_r_peaks_trimmed(signal_raw):\n",
    "    \"\"\"\n",
    "    Trims the square calibration pulse on the left and flat padding tail on the right.\n",
    "    Preserves all 13 heartbeats and returns the clean trimmed signal + peaks.\n",
    "    \"\"\"\n",
    "    y = np.asarray(signal_raw, dtype=np.float64)\n",
    "    N_orig = len(y)\n",
    "\n",
    "    # 1. Baseline Removal on Raw Signal\n",
    "    med_win = int(N_orig * 0.08)\n",
    "    if med_win % 2 == 0:\n",
    "        med_win += 1\n",
    "    baseline = signal.medfilt(y, med_win)\n",
    "    detrended = y - baseline\n",
    "\n",
    "    # 2. Precision Left & Right Boundary Trimming\n",
    "    # Dynamic search for end of calibration square pulse (first 5% of signal)\n",
    "    search_lim = int(N_orig * 0.05)\n",
    "    grad = np.gradient(detrended[:search_lim])\n",
    "    min_grad_idx = np.argmin(grad)  # Steepest falling edge of square pulse\n",
    "\n",
    "    # Left trim: Right after square pulse drops to baseline (x ~ 90), before Beat 1 (x ~ 115)\n",
    "    left_trim = min_grad_idx + 6\n",
    "    left_trim = max(85, min(left_trim, 93))\n",
    "\n",
    "    # Right trim: Right after Beat 13 finishes (x ~ 2020)\n",
    "    right_trim = int(N_orig * 0.950)\n",
    "\n",
    "    # Cut signal\n",
    "    detrended_trimmed = detrended[left_trim:right_trim]\n",
    "    N = len(detrended_trimmed)\n",
    "\n",
    "    # 3. Energy Envelope Generation on Trimmed Signal\n",
    "    grad_trim = np.gradient(detrended_trimmed)\n",
    "    squared_grad = grad_trim ** 2\n",
    "\n",
    "    smooth_win = max(5, int(N * 0.020))\n",
    "    envelope = np.convolve(\n",
    "        squared_grad, np.ones(smooth_win) / smooth_win, mode=\"same\"\n",
    "    )\n",
    "\n",
    "    # 4. Adaptive Peak Finding\n",
    "    min_distance = max(10, int(N * 0.045))  # Minimum spacing between beats\n",
    "    prominence_thresh = np.percentile(envelope, 50) * 0.35\n",
    "\n",
    "    candidate_peaks, _ = signal.find_peaks(\n",
    "        envelope, distance=min_distance, prominence=prominence_thresh\n",
    "    )\n",
    "\n",
    "    # 5. Local Extremum Refinement\n",
    "    refined_peaks = []\n",
    "    search_radius = int(min_distance * 0.40)\n",
    "\n",
    "    for p in candidate_peaks:\n",
    "        left = max(0, p - search_radius)\n",
    "        right = min(N, p + search_radius)\n",
    "        seg = detrended_trimmed[left:right]\n",
    "\n",
    "        if len(seg) == 0:\n",
    "            continue\n",
    "\n",
    "        max_idx = np.argmax(seg)\n",
    "        min_idx = np.argmin(seg)\n",
    "\n",
    "        if abs(seg[max_idx]) >= abs(seg[min_idx]):\n",
    "            refined_peaks.append(left + max_idx)\n",
    "        else:\n",
    "            refined_peaks.append(left + min_idx)\n",
    "\n",
    "    refined_peaks = np.array(sorted(set(refined_peaks)))\n",
    "\n",
    "    return refined_peaks, detrended_trimmed\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Process, Display, and Save Trimmed Results\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "PEAK_DIR = Path(\"intermediate_results/r_peaks_trimmed\")\n",
    "PEAK_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "for res in results:\n",
    "    raw_sig = res[\"signal\"]\n",
    "\n",
    "    # Detect peaks on trimmed signal (Square wave removed)\n",
    "    peaks, trimmed_sig = detect_r_peaks_trimmed(raw_sig)\n",
    "\n",
    "    # Store updated trimmed signal and peaks back into dictionary\n",
    "    res[\"r_peaks\"] = peaks\n",
    "    res[\"filtered_signal\"] = trimmed_sig\n",
    "\n",
    "    # Plot Clean Trimmed ECG\n",
    "    plt.figure(figsize=(16, 4))\n",
    "    plt.plot(trimmed_sig, color=\"black\", lw=1.2, label=\"Clean Detrended ECG\")\n",
    "\n",
    "    if len(peaks) > 0:\n",
    "        plt.scatter(\n",
    "            peaks,\n",
    "            trimmed_sig[peaks],\n",
    "            color=\"red\",\n",
    "            s=45,\n",
    "            zorder=10,\n",
    "            label=f\"Detected Peaks ({len(peaks)})\",\n",
    "        )\n",
    "\n",
    "    plt.title(f\"Row {res['row_index']} : {len(peaks)} Heartbeats Detected\")\n",
    "    plt.xlim(0, len(trimmed_sig))\n",
    "    plt.grid(alpha=0.3)\n",
    "    plt.legend(loc=\"upper right\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # Save output arrays\n",
    "    np.save(\n",
    "        PEAK_DIR / f\"row_{res['row_index']}_r_peaks.npy\", \n",
    "        res[\"r_peaks\"]\n",
