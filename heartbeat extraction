    "# Cell 4: Load ECG report, display image, print size, and validate image\n",
    "\n",
    "def validate_image_path(image_path: Path | str) -> Path:\n",
    "    \"\"\"Validate that the ECG report image path exists and points to a readable file.\"\"\"\n",
    "    try:\n",
    "        path = Path(image_path)\n",
    "        if not path.exists():\n",
    "            raise FileNotFoundError(f\"Image file not found: {path}\")\n",
    "        if not path.is_file():\n",
    "            raise ValueError(f\"Path exists but is not a file: {path}\")\n",
    "        return path\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Image path validation failed.\") from error\n",
    "\n",
    "\n",
    "def load_ecg_report_image(image_path: Path | str) -> np.ndarray:\n",
    "    \"\"\"Load an ECG report image using OpenCV and convert it from BGR to RGB.\"\"\"\n",
    "    try:\n",
    "        path = validate_image_path(image_path)\n",
    "        image_bgr = cv2.imread(str(path), cv2.IMREAD_COLOR)\n",
    "        if image_bgr is None:\n",
    "            raise RuntimeError(f\"OpenCV could not read the image: {path}\")\n",
    "        \n",
    "        image_rgb = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2RGB)\n",
    "        if image_rgb.ndim != 3 or image_rgb.shape[2] != 3:\n",
    "            raise ValueError(\"Loaded image is not a valid 3-channel RGB image.\")\n",
    "        return image_rgb\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to load ECG report image.\") from error\n",
    "\n",
    "\n",
    "def validate_loaded_image(image_rgb: np.ndarray) -> bool:\n",
    "    \"\"\"Validate basic image properties required for ECG preprocessing.\"\"\"\n",
    "    try:\n",
    "        if image_rgb is None:\n",
    "            raise ValueError(\"Image is None.\")\n",
    "        if not isinstance(image_rgb, np.ndarray):\n",
    "            raise ValueError(\"Image is not a NumPy array.\")\n",
    "        if image_rgb.size == 0:\n",
    "            raise ValueError(\"Image is empty.\")\n",
    "        if image_rgb.ndim != 3 or image_rgb.shape[2] != 3:\n",
    "            raise ValueError(\"Image must have shape (height, width, 3).\")\n",
    "        \n",
    "        height, width, _ = image_rgb.shape\n",
    "        if height < 300 or width < 300:\n",
    "            raise ValueError(f\"Image is too small for ECG preprocessing: {width} x {height}\")\n",
    "        if image_rgb.dtype != np.uint8:\n",
    "            raise ValueError(f\"Expected uint8 image, got {image_rgb.dtype}.\")\n",
    "        \n",
    "        return True\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Loaded image validation failed.\") from error\n",
    "\n",
    "\n",
    "def display_ecg_report(image_rgb: np.ndarray, title: str = \"Loaded ECG Report\") -> None:\n",
    "    \"\"\"Display the loaded ECG report image using matplotlib.\"\"\"\n",
    "    try:\n",
    "        plt.figure(figsize=(14, 10))\n",
    "        plt.imshow(image_rgb)\n",
    "        plt.title(title)\n",
    "        plt.axis(\"off\")\n",
    "        plt.show()\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to display ECG report image.\") from error\n",
    "\n",
    "\n",
    "# -----------------------------\n",
    "# Load, validate, display\n",
    "# -----------------------------\n",
    "# (Assumes IMAGE_PATH and INTERMEDIATE_DIR are carried over from Cell 3)\n",
    "\n",
    "ecg_report_rgb = load_ecg_report_image(IMAGE_PATH)\n",
    "validate_loaded_image(ecg_report_rgb)\n",
    "\n",
    "image_height, image_width, image_channels = ecg_report_rgb.shape\n",
    "\n",
    "print(\n",
    "    f\"ECG report loaded successfully.\\n\"\n",
    "    f\"Image path: {IMAGE_PATH}\\n\"\n",
    "    f\"Image size: {image_width} x {image_height} pixels\\n\"\n",
    "    f\"Number of channels: {image_channels}\\n\"\n",
    "    f\"Image dtype: {ecg_report_rgb.dtype}\\n\"\n",
    "    f\"Pixel intensity range: {ecg_report_rgb.min()} to {ecg_report_rgb.max()}\"\n",
    ")\n",
    "\n",
    "display_ecg_report(ecg_report_rgb)\n",
    "\n",
    "# Save a copy for traceability\n",
    "loaded_image_output_path = INTERMEDIATE_DIR / \"cell_04_loaded_ecg_report.png\"\n",
