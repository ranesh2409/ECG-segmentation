    ")\n",
    "\n",
    "# Save intermediate outputs\n",
    "row_mask_output_path = INTERMEDIATE_DIR / \"cell_07_row_detection_mask.png\"\n",
    "cv2.imwrite(str(row_mask_output_path), row_detection_mask)\n",
    "\n",
    "for row_data in ecg_rows:\n",
    "    row_output_path = INTERMEDIATE_DIR / f\"cell_07_ecg_row_{row_data['row_index']}.png\"\n",
    "    cv2.imwrite(str(row_output_path), cv2.cvtColor(row_data[\"image\"], cv2.COLOR_RGB2BGR))\n",
    "\n",
    "print(\n",
