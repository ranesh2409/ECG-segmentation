    "    )\n",
    "\n",
    "    # 2. Plot 1: Overlay View (Morphology & Baseline Alignment)\n",
    "    plt.figure(figsize=(9, 4.5))\n",
    "    for i in range(num_beats):\n",
    "        plt.plot(time_axis, heartbeats[i], alpha=0.5, lw=1.2)\n",
    "\n",
    "    mean_beat = np.mean(heartbeats, axis=0)\n",
    "    plt.plot(\n",
    "        time_axis,\n",
    "        mean_beat,\n",
    "        color=\"black\",\n",
    "        lw=2.5,\n",
    "        linestyle=\"--\",\n",
    "        label=\"Average Beat\",\n",
    "    )\n",
    "    plt.axvline(\n",
    "        0, color=\"red\", linestyle=\":\", alpha=0.7, label=\"Peak Reference (0)\"\n",
    "    )\n",
    "    plt.axhline(0, color=\"gray\", linestyle=\"-\", lw=0.8, alpha=0.5)\n",
    "\n",
    "    plt.title(\n",
    "        f\"Row {row_idx} : Overlaid Single Heartbeats ({num_beats} Total)\",\n",
    "        fontsize=12,\n",
    "        pad=10,\n",
    "    )\n",
    "    plt.xlabel(\"Samples Relative to Peak\")\n",
    "    plt.ylabel(\"Normalized Amplitude\")\n",
    "    plt.grid(alpha=0.3)\n",
    "    plt.legend(loc=\"upper right\", fontsize=8)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # 3. Plot 2: Fixed Grid View (No Cutoffs, Polarity Color-Coded)\n",
    "    cols = 4\n",
    "    rows = int(np.ceil(num_beats / cols))\n",
    "\n",
    "    # Increased vertical figure sizing: 3.2 inches per row\n",
