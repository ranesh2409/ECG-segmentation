    "# ============================================================\n",
    "# Cell 9 : Enhanced Single Heartbeat Extraction\n",
    "#          + Correct Beat Filtering\n",
    "#          + Grid Visualization\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. Extract Heartbeats\n",
    "# ============================================================\n",
    "\n",
    "def extract_single_heartbeats_enhanced(\n",
    "    sig,\n",
    "    peaks,\n",
    "    pre_samples=70,\n",
    "    post_samples=110,\n",
    "    baseline_correct=True\n",
    "):\n",
    "    \"\"\"\n",
    "    Extract fixed-length heartbeat windows around detected R-peaks.\n",
    "\n",
    "    Boundary beats are NOT accepted here.\n",
    "    This prevents incomplete beats from entering the dataset.\n",
    "    \"\"\"\n",
    "\n",
    "    N = len(sig)\n",
    "    beat_length = pre_samples + post_samples\n",
    "\n",
    "    beats_list = []\n",
    "    valid_peaks = []\n",
    "\n",
    "    for p in peaks:\n",
    "\n",
    "        start_idx = p - pre_samples\n",
    "        end_idx = p + post_samples\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Reject incomplete boundary beats\n",
    "        # ----------------------------------------------------\n",
    "        if start_idx < 0 or end_idx > N:\n",
    "            continue\n",
    "\n",
    "        segment = sig[start_idx:end_idx].copy()\n",
    "\n",
    "        if len(segment) != beat_length:\n",
    "            continue\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Baseline correction\n",
    "        # ----------------------------------------------------\n",
    "        if baseline_correct:\n",
    "\n",
    "            baseline_ref = np.mean(\n",
    "                segment[:int(pre_samples * 0.35)]\n",
    "            )\n",
    "\n",
    "            segment = segment - baseline_ref\n",
    "\n",
    "        beats_list.append(segment)\n",
    "        valid_peaks.append(p)\n",
    "\n",
    "    if len(beats_list) == 0:\n",
    "        return np.empty((0, beat_length)), np.array([])\n",
    "\n",
    "    return np.array(beats_list), np.array(valid_peaks)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. Filter Incorrect / False Beats\n",
    "# ============================================================\n",
    "\n",
    "def filter_correct_beats(\n",
    "    heartbeats,\n",
    "    peaks,\n",
    "    pre_samples=70,\n",
    "    min_peak_ratio=0.25,\n",
    "    max_amplitude_ratio=3.0,\n",
    "    rr_min=40,\n",
    "    rr_max=250\n",
    "):\n",
    "    \"\"\"\n",
    "    Filters heartbeat segments to keep only high-quality beats.\n",
    "\n",
    "    Filtering criteria:\n",
    "\n",
    "    1. Valid R-peak location\n",
    "    2. Sufficient R-peak amplitude\n",
    "    3. Reasonable total beat amplitude\n",
    "    4. Reasonable RR interval\n",
    "    5. Removes extreme amplitude outliers\n",
    "    \"\"\"\n",
    "\n",
    "    if len(heartbeats) == 0:\n",
    "        return (\n",
    "            np.empty((0, pre_samples + 110)),\n",
    "            np.array([]),\n",
    "            np.array([])\n",
    "        )\n",
    "\n",
    "    valid_mask = np.ones(len(heartbeats), dtype=bool)\n",
    "\n",
    "    # ========================================================\n",
    "    # STEP 1 : Check R-peak amplitude\n",
    "    # ========================================================\n",
    "\n",
    "    r_values = heartbeats[:, pre_samples]\n",
    "\n",
    "    abs_r_values = np.abs(r_values)\n",
    "\n",
    "    median_r = np.median(abs_r_values)\n",
    "\n",
    "    if median_r > 0:\n",
    "\n",
    "        r_threshold = median_r * min_peak_ratio\n",
    "\n",
    "        valid_mask &= abs_r_values >= r_threshold\n",
    "\n",
    "    # ========================================================\n",
    "    # STEP 2 : Check beat amplitude\n",
    "    # ========================================================\n",
    "\n",
    "    beat_max = np.max(heartbeats, axis=1)\n",
    "    beat_min = np.min(heartbeats, axis=1)\n",
    "\n",
    "    beat_amplitude = beat_max - beat_min\n",
    "\n",
    "    median_amplitude = np.median(beat_amplitude)\n",
    "\n",
    "    if median_amplitude > 0:\n",
    "\n",
    "        min_amp = median_amplitude * 0.25\n",
    "        max_amp = median_amplitude * max_amplitude_ratio\n",
    "\n",
    "        valid_mask &= beat_amplitude >= min_amp\n",
    "        valid_mask &= beat_amplitude <= max_amp\n",
    "\n",
    "    # ========================================================\n",
    "    # STEP 3 : Check RR intervals\n",
    "    # ========================================================\n",
    "\n",
    "    if len(peaks) > 1:\n",
    "\n",
    "        rr_intervals = np.diff(peaks)\n",
    "\n",
    "        rr_valid = np.ones(len(peaks), dtype=bool)\n",
    "\n",
    "        # First beat\n",
    "        if len(rr_intervals) > 0:\n",
    "\n",
    "            first_rr = rr_intervals[0]\n",
    "\n",
    "            rr_valid[0] = (\n",
    "                rr_min <= first_rr <= rr_max\n",
    "            )\n",
    "\n",
    "        # Middle beats\n",
    "        for i in range(1, len(peaks) - 1):\n",
    "\n",
    "            prev_rr = rr_intervals[i - 1]\n",
    "            next_rr = rr_intervals[i]\n",
    "\n",
    "            rr_valid[i] = (\n",
    "                rr_min <= prev_rr <= rr_max\n",
    "                and\n",
    "                rr_min <= next_rr <= rr_max\n",
    "            )\n",
    "\n",
    "        # Last beat\n",
    "        if len(rr_intervals) > 0:\n",
    "\n",
    "            last_rr = rr_intervals[-1]\n",
    "\n",
    "            rr_valid[-1] = (\n",
    "                rr_min <= last_rr <= rr_max\n",
    "            )\n",
    "\n",
    "        valid_mask &= rr_valid\n",
    "\n",
    "    # ========================================================\n",
    "    # STEP 4 : Morphology outlier filtering\n",
    "    # ========================================================\n",
    "\n",
    "    valid_indices = np.where(valid_mask)[0]\n",
    "\n",
    "    if len(valid_indices) >= 3:\n",
    "\n",
    "        good_beats = heartbeats[valid_indices]\n",
    "\n",
    "        # Mean morphology\n",
    "        mean_beat = np.mean(good_beats, axis=0)\n",
    "\n",
    "        # Normalize\n",
    "        mean_norm = np.linalg.norm(mean_beat)\n",
    "\n",
    "        if mean_norm > 0:\n",
    "\n",
    "            mean_beat_normalized = (\n",
    "                mean_beat / mean_norm\n",
    "            )\n",
    "\n",
    "            for idx in valid_indices:\n",
    "\n",
    "                beat = heartbeats[idx]\n",
    "\n",
    "                beat_norm = np.linalg.norm(beat)\n",
    "\n",
    "                if beat_norm == 0:\n",
    "                    valid_mask[idx] = False\n",
    "                    continue\n",
    "\n",
    "                beat_normalized = beat / beat_norm\n",
    "\n",
    "                # Cosine similarity\n",
    "                similarity = np.dot(\n",
    "                    beat_normalized,\n",
    "                    mean_beat_normalized\n",
    "                )\n",
    "\n",
    "                # Reject very different morphology\n",
    "                if similarity < 0.55:\n",
    "                    valid_mask[idx] = False\n",
    "\n",
    "    # ========================================================\n",
    "    # Return only correct beats\n",
    "    # ========================================================\n",
    "\n",
    "    final_indices = np.where(valid_mask)[0]\n",
    "\n",
    "    filtered_beats = heartbeats[final_indices]\n",
    "    filtered_peaks = peaks[final_indices]\n",
    "\n",
    "    return (\n",
    "        filtered_beats,\n",
    "        filtered_peaks,\n",
    "        final_indices\n",
    "    )\n",
