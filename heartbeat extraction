    "        axes[i].axvline(0, color=\"red\", linestyle=\":\", alpha=0.6)\n",
    "        axes[i].axhline(0, color=\"gray\", linestyle=\"-\", lw=0.6, alpha=0.4)\n",
    "        axes[i].set_title(f\"Beat #{i+1} (Peak @ {peaks[i]})\", fontsize=10)\n",
    "        axes[i].grid(alpha=0.3)\n",
    "\n",
