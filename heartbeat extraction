    "# ============================================================\n",
    "# Cell 9 : Enhanced Single Heartbeat Extraction & Grid View\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def extract_single_heartbeats_enhanced(\n",
    "    sig, peaks, pre_samples=70, post_samples=110, baseline_correct=True\n",
    "):\n",
    "    \"\"\"Extracts fixed-length single heartbeat windows with baseline correction\n",
    "\n",
    "    and boundary padding protection.\n",
    "    \"\"\"\n",
    "    N = len(sig)\n",
    "    beats_list = []\n",
    "\n",
    "    for p in peaks:\n",
    "        start_idx = p - pre_samples\n",
    "        end_idx = p + post_samples\n",
    "\n",
    "        # Boundary padding protection\n",
    "        pad_left = max(0, -start_idx)\n",
    "        pad_right = max(0, end_idx - N)\n",
    "\n",
    "        valid_start = max(0, start_idx)\n",
    "        valid_end = min(N, end_idx)\n",
    "\n",
    "        # Slice segment\n",
    "        segment = sig[valid_start:valid_end]\n",
    "\n",
    "        # Pad with edge values if near bounds\n",
    "        if pad_left > 0 or pad_right > 0:\n",
    "            segment = np.pad(segment, (pad_left, pad_right), mode=\"edge\")\n",
    "\n",
    "        # Per-beat baseline correction (forces pre-P baseline to 0.0)\n",
    "        if baseline_correct:\n",
    "            baseline_ref = np.mean(segment[: int(pre_samples * 0.35)])\n",
    "            segment = segment - baseline_ref\n",
    "\n",
    "        beats_list.append(segment)\n",
    "\n",
    "    return np.array(beats_list)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Process, Segment, and Plot Individual Heartbeats\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "BEAT_DIR = Path(\"intermediate_results/single_beats\")\n",
    "BEAT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "PRE_SAMPLES = 70  # Samples before peak (P-wave & PR segment)\n",
    "POST_SAMPLES = 110  # Samples after peak (ST segment & T-wave)\n",
    "time_axis = np.arange(-PRE_SAMPLES, POST_SAMPLES)\n",
    "\n",
    "for res in results:\n",
    "    clean_sig = res[\"filtered_signal\"]\n",
    "    peaks = res[\"r_peaks\"]\n",
    "    row_idx = res[\"row_index\"]\n",
    "\n",
    "    # 1. Extract heartbeats with baseline correction & padding guard\n",
    "    heartbeats = extract_single_heartbeats_enhanced(\n",
    "        clean_sig, peaks, pre_samples=PRE_SAMPLES, post_samples=POST_SAMPLES\n",
    "    )\n",
    "\n",
    "    res[\"heartbeats\"] = heartbeats\n",
    "    res[\"beat_time_axis\"] = time_axis\n",
    "    num_beats = len(heartbeats)\n",
    "\n",
    "    print(\n",
