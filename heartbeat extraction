    "        row_count = len(extracted_rows)\n",
    "        plt.figure(figsize=(18, max(8, 2.6 * row_count)))\n",
    "        for idx, row_data in enumerate(extracted_rows):\n",
    "            plt.subplot(row_count, 1, idx + 1)\n",
    "            plt.imshow(row_data[\"image\"])\n",
    "            plt.title(f\"Extracted Row {row_data['row_index']} (y={row_data['y_start']}:{row_data['y_end']})\")\n",
    "            plt.axis(\"off\")\n",
    "\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to display ECG row detection results.\") from error\n",
    "\n",
    "\n",
    "# -----------------------------\n",
    "# Detect and extract ECG rows\n",
    "# -----------------------------\n",
    "row_detection_mask = create_row_detection_mask(ecg_grid_removed_rgb)\n",
    "row_raw_projection, row_smoothed_projection, detected_row_centers = detect_row_centers_from_projection(row_detection_mask, expected_rows=4)\n",
