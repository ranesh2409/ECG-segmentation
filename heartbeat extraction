    "# Cell 6: Remove ECG grid while preserving black ECG waveform\n",
    "\n",
    "def enhance_luminance_with_clahe(image_rgb: np.ndarray, clip_limit: float = 2.0, tile_grid_size: tuple = (8, 8)) -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n",
    "    \"\"\"Enhance luminance contrast using LAB color space and CLAHE.\"\"\"\n",
    "    try:\n",
    "        if image_rgb is None or image_rgb.ndim != 3:\n",
    "            raise ValueError(\"Input must be a valid RGB image.\")\n",
    "\n",
    "        lab_image = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2LAB)\n",
    "        l_channel, a_channel, b_channel = cv2.split(lab_image)\n",
    "\n",
    "        clahe = cv2.createCLAHE(clipLimit=float(clip_limit), tileGridSize=tuple(tile_grid_size))\n",
    "        enhanced_lab = cv2.merge([clahe.apply(l_channel), a_channel, b_channel])\n",
    "        \n",
    "        return lab_image, enhanced_lab, cv2.cvtColor(enhanced_lab, cv2.COLOR_LAB2RGB)\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to enhance luminance using CLAHE.\") from error\n",
    "\n",
    "\n",
    "def detect_red_grid_pixels_lab(image_rgb: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Detect red ECG grid pixels using LAB color information.\"\"\"\n",
    "    try:\n",
    "        l_channel, a_channel, _ = cv2.split(cv2.cvtColor(image_rgb, cv2.COLOR_RGB2LAB))\n",
    "\n",
    "        # Red/pink ECG grid has elevated LAB a-channel and relatively high luminance.\n",
    "        a_threshold = max(130, int(np.percentile(a_channel, 68)))\n",
    "        l_threshold = max(105, int(np.percentile(l_channel, 20)))\n",
    "\n",
    "        red_grid_mask = ((a_channel >= a_threshold) & (l_channel >= l_threshold)).astype(np.uint8) * 255\n",
    "        small_kernel = cv2.getStructuringElement(cv2.MORPH_RECT, MORPH_KERNEL_SMALL)\n",
    "        \n",
    "        return cv2.morphologyEx(red_grid_mask, cv2.MORPH_OPEN, small_kernel, iterations=1)\n",
    "    except Exception as error:\n",
    "        raise RuntimeError(\"Failed to detect red ECG grid pixels in LAB space.\") from error\n",
    "\n",
    "\n",
    "def detect_black_waveform_pixels(image_rgb: np.ndarray) -> np.ndarray:\n",
    "    \"\"\"Detect black ECG waveform pixels so they can be preserved during grid removal.\"\"\"\n",
