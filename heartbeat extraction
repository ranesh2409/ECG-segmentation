    "            plt.axis(\"off\")\n",
    "\n",
    "        # Plot projection graph\n",
    "        plt.subplot(222)\n",
    "        y_axis = np.arange(len(smoothed_projection))\n",
    "        plt.plot(raw_projection, y_axis, color=\"lightgray\", label=\"Raw projection\")\n",
    "        plt.plot(smoothed_projection, y_axis, color=\"black\", label=\"Smoothed projection\")\n",
    "        plt.scatter(smoothed_projection[row_centers], row_centers, color=\"red\", s=45, label=\"Detected row centers\")\n",
    "        plt.gca().invert_yaxis()\n",
    "        plt.title(\"Horizontal Projection with Detected Peaks\")\n",
    "        plt.xlabel(\"Foreground Pixel Count\")\n",
    "        plt.ylabel(\"Y Position\")\n",
    "        plt.legend()\n",
    "\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
