    "\n",
    "    # Save outputs\n",
    "    np.save(BEAT_DIR / f\"row_{row_idx}_heartbeats.npy\", heartbeats)\n",
    "\n",
    "print(\"Enhanced single heartbeat extraction and visualization completed.\")"
